    "confirm_named_executor": null,
    "no_will_explainer": null
  },
  "add_ons": [
    {
      "id": "veteran_yes",
      "spec_key": "veteran_status == yes",
      "when": {
        "fact": "veteran_status",
        "op": "eq",
        "value": "yes"
      },
      "recommend_tasks": [
        "notify_va_if_veteran",
        "notify_military_retiree_benefits"
      ],
      "add_support_resources": [
        "veterans_crisis_line"
      ],
      "source_urls": [
        "https://www.va.gov/burials-memorials/",
        "https://www.veteranscrisisline.net"
      ]
    },
    {
      "id": "veteran_unknown",
      "spec_key": "veteran_status == unknown",
      "when": {
        "fact": "veteran_status",
        "op": "eq",
        "value": "unknown"
      },
      "add_notes": [
        "check_if_they_served_note"
      ]
    },
    {
      "id": "veteran_no",
      "spec_key": "veteran_status == no",
      "when": {
        "fact": "veteran_status",
        "op": "eq",
        "value": "no"
      },
      "mark_probably_not_applicable": [
        "notify_va_if_veteran",
        "notify_military_retiree_benefits"
      ]
    },
    {
      "id": "estate_plan_location_known",
      "spec_key": "confirm_named_executor",
      "when": {
        "fact": "estate_plan_status",
        "op": "eq",
        "value": "yes_location_known"
      },
      "add_tasks": [
        "confirm_named_executor"
      ]
    },
    {
      "id": "estate_plan_location_unknown",
      "spec_key": "find_the_will, confirm_named_executor",
      "when": {
        "fact": "estate_plan_status",
        "op": "eq",
        "value": "yes_location_unknown"
      },
      "add_tasks": [
        "find_the_will",
        "confirm_named_executor"
      ]
    },
    {
      "id": "no_will",
      "spec_key": "no_will_explainer",
      "when": {
        "fact": "estate_plan_status",
        "op": "in",
        "value": [
          "no",
          "unknown"
        ]
      },
      "add_tasks": [
        "no_will_explainer"
      ],
      "attorney_flag": true,
      "legal_review": true
    },
    {
      "id": "power_of_attorney",
      "spec_key": "poa_authority_note",
      "when": {
        "fact": "user_role",
        "op": "eq",
        "value": "power_of_attorney"
      },
      "add_notes": [
        "poa_authority_note"
      ],
      "attorney_flag": true,
      "legal_review": true
    },
    {
      "id": "certificate_may_be_pending",
      "spec_key": "certificate_may_be_pending_note",
      "when": {
        "fact": "base_path",
        "op": "in",
        "value": [
          "sudden_loss",
          "sudden_loss_investigation"
        ]
      },
      "add_notes": [
        "certificate_may_be_pending_note"
      ],
      "source_urls": [
        "https://www.cdc.gov/nchs/data/misc/hb_me.pdf",
        "https://www.health.pa.gov/topics/Documents/Reporting-Registries/SRN%202019-12%20Follow-up%20with%20Coroners%20and%20Medical%20Examiners%20for%20Pending%20Manner%20and%20Causes%20of%20Death.pdf"
      ]
    },
    {
      "id": "certificate_waiting_on_place",
      "spec_key": "place_of_death.jurisdiction is null",
      "reason": "Only for a US death. A death outside the US gets the outside_us note instead.",
      "when": {
        "all": [
          {
            "fact": "place_of_death.jurisdiction",
            "op": "is_null"
          },
          {
            "fact": "place_of_death.outside_us",
            "op": "eq",
            "value": false
          }
        ]
      },
      "add_notes": [
        "certificate_task_waiting_on_place_note"
      ]
    },
    {
      "id": "dmv_waiting_on_where_they_lived",
      "spec_key": "residence_jurisdiction just_in_time_fallback",
      "when": {
        "all": [
          {
            "fact": "dmv_jurisdiction",
            "op": "is_null"
          },
          {
            "fact": "place_of_death.outside_us",
            "op": "eq",
            "value": false
          }
        ]
      },
      "add_notes": [
        "dmv_where_they_lived_note"
      ]
    },
    {
      "id": "funeral_home_reports_to_ssa",
      "spec_key": "change_task ssa_notify",
      "reason": "In most cases the funeral director reports the death to Social Security using the SSN the family provides.",
      "when": {
        "all": [
          {
            "fact": "completed_items",
            "op": "contains",
            "value": "funeral_provider_chosen"
          },
          {
            "fact": "completed_items",
            "op": "not_contains",
            "value": "ssa_notified"
          }
        ]
      },
      "replace_tasks": {
        "notify_social_security": "confirm_funeral_home_reported_death"
      },
      "source_urls": [
        "https://www.ssa.gov/faqs/en/questions/KA-02077.html",
        "https://www.ssa.gov/forms/ssa-721.pdf"
      ]
    },
    {
      "id": "death_outside_us",
      "spec_key": "UC-CASE-04 outside_us, UC-CASE-16",
      "when": {
        "fact": "place_of_death.outside_us",
        "op": "eq",
        "value": true
      },
      "add_tasks": [
        "talk_to_estate_attorney"
      ],
      "add_notes": [
        "outside_us_not_covered"
      ],
      "attorney_flag": true
    },
    {
      "id": "attorney_triggers",
      "spec_key": "UC-CASE-16",
      "when": {
        "fact": "attorney_triggers",
        "op": "not_empty"
      },
      "add_tasks": [
        "talk_to_estate_attorney"
      ],
      "attorney_flag": true
    },
    {
      "id": "unverified_jurisdiction",
      "spec_key": "UC-CASE-16 verified link only (OPEN-06)",
      "when": {
        "all": [
          {
            "fact": "place_of_death.jurisdiction",
            "op": "not_null"
          },
          {
            "fact": "place_jurisdiction_verified",
            "op": "eq",
            "value": false
          }
        ]
      },
      "add_notes": [
        "confirm_with_the_office_note"
      ],
      "source_urls": [
        "https://cdc.gov/nchs/w2w"
      ]
    },
    {
      "id": "secure_now_first",
      "spec_key": "UC-CASE-13 pets or dependents mentioned",
      "when": {
        "fact": "secure_now_first",
        "op": "eq",
        "value": true
      },
      "recommend_tasks": [
        "secure_home_and_identity"
      ]
    },
    {
      "id": "loss_survivor_resources",
      "spec_key": "UC-CASE-05 loss_survivor_resources",
      "when": {
        "fact": "loss_survivor_resources",
        "op": "eq",
        "value": true
      },
      "add_support_resources": [
        "afsp_loss_survivors"
      ],
      "source_urls": [
        "https://afsp.org/ive-lost-someone/"
      ]
    }
  ],
