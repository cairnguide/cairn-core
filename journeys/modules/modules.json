    {
      "id": "M-FAITH-COMMUNITY",
      "version": 1,
      "title": "Faith community",
      "applies_when": {
        "fact": "faith_tradition",
        "op": "not_in",
        "value": [
          "none",
          "prefer_not_to_say"
        ]
      },
      "when_unknown": "exclude",
      "qualifying_question": "Is there a faith or cultural tradition you would like the arrangements to honor?",
      "add_steps": [
        {
          "step_id": "S-W2-CONTACT-FAITH",
          "phase": "W2",
          "position": "first"
        }
      ],
      "remove_steps": [],
      "step_overrides": {},
      "support_resources": [],
      "citations": []
    },
    {
      "id": "M-FAITH-JEWISH",
      "version": 1,
      "title": "Jewish tradition",
      "applies_when": {
        "fact": "faith_tradition",
        "op": "eq",
        "value": "jewish"
      },
      "when_unknown": "exclude",
      "qualifying_question": null,
      "add_steps": [],
      "remove_steps": [],
      "flags": [
        "time_sensitive_disposition"
      ],
      "step_overrides": {
        "S-W2-CONTACT-FAITH": {
          "priority": "urgent",
          "note": "Jewish tradition calls for burial as soon as possible after death. Families are encouraged to contact the rabbi first, and many communities have a chevra kadisha (burial society) that helps."
        },
        "S-W2-COMPARE-FUNERAL-HOMES": {
          "note": "Ask whether the funeral home observes Jewish customs. Jewish funerals traditionally avoid embalming and viewing. Your rabbi can advise on which providers to use."
        },
        "S-W2-CHOOSE-DISPOSITION": {
          "note": "Ask your rabbi about cremation, since many Jewish communities do not practice it."
        }
      },
      "support_resources": [],
      "citations": [
        "SRC-RA-JEWISH-FUNERAL",
        "SRC-URJ-JEWISH-FUNERAL"
      ]
    },
    {
      "id": "M-FAITH-MUSLIM",
      "version": 1,
      "title": "Muslim tradition",
      "applies_when": {
        "fact": "faith_tradition",
        "op": "eq",
        "value": "muslim"
      },
      "when_unknown": "exclude",
      "qualifying_question": null,
      "add_steps": [],
      "remove_steps": [],
      "flags": [
        "time_sensitive_disposition"
      ],
      "step_overrides": {
        "S-W2-CONTACT-FAITH": {
          "priority": "urgent",
          "note": "Islamic practice calls for burial as soon as possible, often within 24 hours, with ritual washing (ghusl) and shrouding first. Many mosques help families with these steps. Contact the mosque or imam right away."
        },
        "S-W2-COMPARE-FUNERAL-HOMES": {
          "note": "Ask the mosque which funeral homes they work with, and tell the funeral home about the timing need at the first call."
        }
      },
      "support_resources": [],
      "citations": [
        "SRC-MASJID-JANAZAH"
      ]
    },
    {
      "id": "M-DIED-OUT-OF-STATE",
      "version": 1,
      "title": "Died in a different state than home",
      "applies_when": {
        "all": [
          {
            "fact": "death_country",
            "op": "eq",
            "value": "US"
          },
          {
            "fact": "death_state",
            "op": "ne_fact",
            "value": "residence_state"
          }
        ]
      },
      "when_unknown": "exclude",
      "qualifying_question": null,
      "add_steps": [],
      "remove_steps": [],
      "step_overrides": {
        "S-W1-HOW-DC-IS-MADE": {
          "note": "Because the death happened in a different state than where they lived, certified copies come from the state where the death happened."
        },
        "S-W2-COMPARE-FUNERAL-HOMES": {
          "note": "If you want them brought home, ask each funeral home how they handle transfers between states and what it costs."
        }
      },
      "support_resources": [],
      "citations": [
        "SRC-CDC-W2W"
      ]
    },
