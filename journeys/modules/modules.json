{
  "schema_version": "1.0.0",
  "modules": [
    {
      "id": "M-VETERAN",
      "version": 1,
      "title": "Veteran",
      "applies_when": {
        "fact": "is_veteran",
        "op": "eq",
        "value": true
      },
      "when_unknown": "ask",
      "qualifying_question": "Did your loved one ever serve in the military?",
      "add_steps": [
        {
          "step_id": "S-W3-VA-NOTIFY",
          "phase": "W3"
        },
        {
          "step_id": "S-W2-VA-MEMORIAL-BENEFITS",
          "phase": "W2",
          "after": "S-W2-COMPARE-FUNERAL-HOMES"
        },
        {
          "step_id": "S-W3-VA-BURIAL-ALLOWANCE",
          "phase": "W3"
        }
      ],
      "remove_steps": [],
      "step_overrides": {
        "S-W2-HEADSTONE": {
          "note": "Eligible veterans can receive a government headstone, marker, or medallion at no cost. See the VA memorial benefits step before ordering a private marker."
        }
      },
      "support_resources": [
        "SRC-VCL-988"
      ],
      "citations": [
        "SRC-VA-QSG-BURIAL",
        "SRC-VCL-988"
      ]
    },
    {
      "id": "M-SSA-BENEFICIARY",
      "version": 1,
      "title": "Received Social Security",
      "applies_when": {
        "fact": "received_ssa_benefits",
        "op": "eq",
        "value": true
      },
      "when_unknown": "include",
      "qualifying_question": "Was your loved one receiving Social Security payments?",
      "add_steps": [
        {
          "step_id": "S-W3-SSA-RETURN-PAYMENT",
          "phase": "W3",
          "after": "S-W3-SSA-REPORT"
        }
      ],
      "remove_steps": [],
      "step_overrides": {},
      "support_resources": [],
      "citations": [
        "SRC-USAGOV-SSA-REPORT"
      ]
    },
    {
      "id": "M-SURVIVING-SPOUSE",
      "version": 1,
      "title": "User is the surviving spouse",
      "applies_when": {
        "fact": "user_role",
        "op": "eq",
        "value": "surviving_spouse"
      },
      "when_unknown": "exclude",
      "qualifying_question": null,
      "add_steps": [],
      "remove_steps": [],
      "step_overrides": {
        "S-W3-SSA-SURVIVOR": {
          "priority": "high",
          "note": "As the surviving spouse, you may be the first in line for the one-time payment."
        },
        "S-W7-FINAL-1040": {
          "note": "The IRS treats a surviving spouse as married for the whole year of death if they do not remarry that year."
        }
      },
      "support_resources": [],
      "citations": [
        "SRC-SSA-CFR-404-390",
        "SRC-IRS-FINAL-RETURN"
      ]
    },
    {
      "id": "M-EMPLOYED",
      "version": 1,
      "title": "Was working or had an employer plan",
      "applies_when": {
        "any": [
          {
            "fact": "was_employed",
            "op": "eq",
            "value": true
          },
          {
            "fact": "had_employer_plan",
            "op": "eq",
            "value": true
          }
        ]
      },
      "when_unknown": "ask",
      "qualifying_question": "Was your loved one working, or did they have a pension or retirement plan from a job?",
      "answer_facts": {
        "yes": {
          "was_employed": true
        },
        "no": {
          "was_employed": false,
          "had_employer_plan": false
        }
      },
      "add_steps": [
        {
          "step_id": "S-W4-EMPLOYER",
          "phase": "W4",
          "after": "S-W4-LIFE-INSURANCE"
        }
      ],
      "remove_steps": [],
      "step_overrides": {},
      "support_resources": [],
      "citations": [
        "SRC-IRS-RETIREMENT-DEATH"
      ]
    },
    {
      "id": "M-IMMIGRATION",
      "version": 1,
      "title": "Pending immigration case",
      "applies_when": {
        "fact": "pending_immigration_case",
        "op": "eq",
        "value": true
      },
      "when_unknown": "ask_if",
      "ask_if": {
        "fact": "citizenship_status",
        "op": "ne",
        "value": "us_citizen"
      },
      "qualifying_question": "Was your loved one part of any immigration petition or application that was still in progress?",
      "add_steps": [
        {
          "step_id": "S-W3-USCIS",
          "phase": "W3"
        }
      ],
      "remove_steps": [],
      "step_overrides": {},
      "support_resources": [],
      "citations": [
        "SRC-USCIS-PM-V7A9"
      ]
    },
    {
