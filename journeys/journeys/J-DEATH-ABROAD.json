        "S-W3-SSA-REPORT",
        "S-W3-SSA-SURVIVOR",
        "S-W3-CREDIT-BUREAUS",
        "S-W3-DMV-LICENSE"
      ]
    },
    {
      "phase": "W4",
      "steps": [
        "S-W4-BANKS",
        "S-W4-DEBTS",
        "S-W4-LIFE-INSURANCE",
