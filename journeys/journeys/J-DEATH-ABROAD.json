{
  "schema_version": "1.0.0",
  "id": "J-DEATH-ABROAD",
  "version": 1,
  "status": "draft_pending_legal_review",
  "title": "A U.S. citizen who died outside the United States",
  "trailhead": "C_sudden",
  "description": "For a death abroad. The U.S. embassy or consulate helps, and a Consular Report of Death Abroad is used in place of a U.S. state death certificate for estate matters.",
  "applies_when": {
    "all": [
      {
        "fact": "death_country",
        "op": "ne",
        "value": "US"
      },
      {
        "any": [
          {
            "fact": "citizenship_status",
            "op": "eq",
            "value": "us_citizen"
          },
          {
            "not": {
              "fact": "citizenship_status",
              "op": "exists"
            }
          }
        ]
      }
    ]
  },
  "dependency_substitutions": {
    "S-W1-ORDER-DC": "S-W1-CRODA",
    "S-W1-HOW-DC-IS-MADE": "S-W1-CRODA"
  },
  "phases": [
    {
      "phase": "W0",
      "steps": [
        "S-W0-ABROAD-CONSULATE",
        "S-W0-TELL-FAMILY",
        "S-W0-SECURE-HOME",
        "S-W0-FIND-WISHES"
      ]
    },
    {
      "phase": "W1",
      "steps": [
        "S-W1-CRODA",
        "S-W1-CHECK-DC"
      ]
    },
    {
      "phase": "W2",
      "steps": [
        "S-W2-REPATRIATION",
