{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cairn.guide/schemas/source.schema.json",
  "title": "Cairn citation registry",
  "type": "object",
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "authority_level",
          "url",
          "retrieved"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "publisher": {
            "type": "string",
            "minLength": 1
          },
          "authority_level": {
            "enum": [
              "primary_federal",
              "primary_state",
              "statute",
              "regulation",
              "issuing_institution",
              "official_nonprofit",
              "faith_authority",
              "internal"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://"
          },
          "retrieved": {
            "type": "string",
            "format": "date"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          },
          "verification_note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}