# Secrets for `npx wrangler dev`. Copy to cloudflare/.dev.vars (gitignored) and fill in.
# The container runs in Docker on this machine, so use host.docker.internal to reach a local Postgres.
DATABASE_URL=postgresql://cairn_api_login:CHANGE_ME@host.docker.internal:5432/cairn
CAIRN_OWNER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/cairn
