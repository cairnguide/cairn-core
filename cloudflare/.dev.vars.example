# Secrets for `npx wrangler dev`. Copy to cloudflare/.dev.vars (gitignored) and fill in.
# The container runs in Docker on this machine, so use host.docker.internal to reach a local MongoDB.
# Copy the two URIs from the repository's .env (scripts/dev-setup.sh writes them) and change the host.
MONGODB_URI=mongodb://cairn_api:CHANGE_ME@host.docker.internal:27017/cairn?authSource=cairn&replicaSet=rs0&directConnection=true
CAIRN_JOBS_MONGODB_URI=mongodb://cairn_jobs:CHANGE_ME@host.docker.internal:27017/cairn?authSource=cairn&replicaSet=rs0&directConnection=true
# CAIRN_SMTP_HOST=
# CAIRN_SMTP_USERNAME=
# CAIRN_SMTP_PASSWORD=
# CAIRN_EMAIL_FROM=
# CAIRN_AUTH0_MGMT_CLIENT_ID=
# CAIRN_AUTH0_MGMT_CLIENT_SECRET=
# CAIRN_APPLE_CLIENT_ID=
# CAIRN_APPLE_TEAM_ID=
# CAIRN_APPLE_KEY_ID=
# CAIRN_APPLE_PRIVATE_KEY=
