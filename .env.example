# Cairn API settings for local development and GitHub Codespaces.
# scripts/dev-setup.sh copies this to .env and fills in MONGODB_URI and CAIRN_JOBS_MONGODB_URI.
# .env is gitignored. Never commit real values. On Cloudflare these become Worker vars and secrets
# (see README.md, "Deploy to Cloudflare").

# ---- API (cairn_api.main) --------------------------------------------------------------
# The login user the API connects as. Holds only the cairnApp role. Never an administrator.
# On Atlas: mongodb+srv://cairn_api:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://cairn_api:CHANGE_ME@localhost:27017/cairn?authSource=cairn&replicaSet=rs0
CAIRN_MONGODB_DB=cairn

# Auth0 (see auth0/README.md). Placeholder values let the API start. Signed-in requests need a real tenant.
CAIRN_AUTH0_DOMAIN=cairn-dev.us.auth0.com
CAIRN_AUTH0_AUDIENCE=https://api.cairn.example
CAIRN_CLAIM_NAMESPACE=https://cairn.invalid/
CAIRN_AUTH0_EMAIL_CONNECTION=email

# Policy versions the client must send back, and the links on the welcome and decline screens.
CAIRN_TERMS_VERSION=terms-dev
CAIRN_PRIVACY_VERSION=privacy-dev
CAIRN_PRIVACY_POLICY_URL=https://cairn.example/privacy
CAIRN_TERMS_URL=https://cairn.example/terms
CAIRN_JOURNEY_MAP_URL=https://cairn.example/first-weeks
CAIRN_SUPPORT_URL=https://cairn.example/support
CAIRN_AI_PROVIDER_NAME=Example AI Provider

# Development only: lets POST /v1/dev/token sign in the test logins (database/README.md) without
# Auth0. scripts/dev-setup.sh adds a random value. Never set it anywhere real users are.
# CAIRN_DEV_AUTH_SECRET=

# Optional
# Browser origins allowed to call the API (CORS), comma-separated. Unset allows none.
# CAIRN_CORS_ORIGINS=http://localhost:5173
# CAIRN_DB_POOL_MIN=1
# CAIRN_DB_POOL_MAX=10
# CAIRN_REGISTRATION_COPY=
# CAIRN_CASE_COPY=
# CAIRN_VOICES_DIR=
# CAIRN_OVERWHELM_SKIP_THRESHOLD=3

# ---- Scheduled jobs (cairn_api.jobs, make run-jobs) -----------------------------------
# The jobs user's connection string (the cairnJobs role). Only the jobs process reads it, never the API.
CAIRN_JOBS_MONGODB_URI=mongodb://cairn_jobs:CHANGE_ME@localhost:27017/cairn?authSource=cairn&replicaSet=rs0

# Email (outbound job). Leave unset and the job answers "skipped".
# CAIRN_SMTP_HOST=
# CAIRN_SMTP_PORT=587
# CAIRN_SMTP_USERNAME=
# CAIRN_SMTP_PASSWORD=
# CAIRN_EMAIL_FROM=Cairn <no-reply@mail.example>

# Identity cleanup job. Leave unset and the job answers "skipped".
# CAIRN_AUTH0_MGMT_CLIENT_ID=
# CAIRN_AUTH0_MGMT_CLIENT_SECRET=
# CAIRN_APPLE_CLIENT_ID=
# CAIRN_APPLE_TEAM_ID=
# CAIRN_APPLE_KEY_ID=
# CAIRN_APPLE_PRIVATE_KEY_FILE=
